# Beginner preset — one Ollama model, defaults for everything else.
# Copy to active config:
#   cp config/.env.ollama.beginner config/.env
#
# Do not edit unless something fails. Expert options → docs/setup/LLM_SETUP.md

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:14b

# Same model for import + chat (you only need one `ollama pull`)
PIPELINE_MODEL=qwen2.5:14b
CHAT_MODEL=qwen2.5:14b

UI_AGENT_WORKSPACE=1
UI_SHOW_CADENCE=0
UI_MODE=simple
LEARNING_AGENT_ENABLED=0
CLASSIFICATION_AUDIT_ENABLED=0
