# OpenAI cloud preset — copy to active config:
#   cp config/.env.openai config/.env
# Then set OPENAI_API_KEY below (never commit a real key).
# Same common settings as .env.ollama / .env.lmstudio; only the LLM block differs.
# Full commented reference (all providers): config/.env.example
# Docs: docs/setup/LLM_SETUP.md — restart ./start.sh after changes.

# =============================================================================
# Common — web app, pipeline, UI (same regardless of LLM backend)
# =============================================================================

# --- Web app paths (optional; defaults match a normal checkout) ---
# SQLite database file for transactions, labels, rules, chat history, etc.
# FINANCE_DB_PATH=data/finance.db
# Folder where uploaded / dropped CSVs wait to be scanned.
# FINANCE_INBOX_DIR=input
# Folder where processed CSVs are moved after a successful import.
# FINANCE_PROCESSED_DIR=processed
# If true, move inbox CSVs into FINANCE_PROCESSED_DIR after import; if false, leave them in place.
# FINANCE_MOVE_PROCESSED=true

# --- Web UI feature flags (1/true/yes/on = on; 0/false/no/off = off) ---
# Show the Agent Workspace chrome (sidebar / Ask flow). Keep 1 for the normal product UI.
UI_AGENT_WORKSPACE=1
# Show the Cadence tab, pending-cadence UI, chat propose_cadence, and Learning Agent cadence analysis.
UI_SHOW_CADENCE=0
# simple = Import / Ask / Check labels / Settings only.
# expert = also Find & edit and Automate (Custom Rules). Users can override in Settings for this browser.
UI_MODE=simple
# After bulk Apply on Find & edit, show an AI insight modal. 0 = Apply works, no LLM insight call.
EDIT_INSIGHT_ENABLED=1

# --- Chat (Ask / Workspace) ---
# Prior user+assistant turns sent with each chat request (0 = none). Max 100. Default 20.
# CHAT_HISTORY_MESSAGES=20
# Assumed context window (tokens) for the toolbar meter only — does not change the model.
# CHAT_CONTEXT_TOKEN_LIMIT=32768

# --- Learning Agent (scheduled Decision Analyst → Workspace inbox) ---
# Master switch for the background job that mines decision_events into inbox insights.
LEARNING_AGENT_ENABLED=0
# Hours between automatic runs (minimum 1). Default 3.
# LEARNING_AGENT_INTERVAL_HOURS=3
# Only consider decision events from the last N days. Default 30.
# LEARNING_AGENT_LOOKBACK_DAYS=30
# Cap how many new insights one run may insert. Default 10.
# LEARNING_AGENT_MAX_INSIGHTS=10
# Max tool-calling rounds per Learning Agent LLM session. Default 8.
# LEARNING_AGENT_MAX_TOOL_ROUNDS=8
# If 0, analysis without LLM when supported. Default 1.
# LEARNING_AGENT_USE_LLM=1
# Optional larger model for Learning Agent only; if unset, uses CHAT_MODEL.
# LEARNING_AGENT_MODEL=gpt-4o

# --- Payroll spillover ---
# Paychecks in the last N days of a month attribute to the *next* budget month.
# PAYROLL_SPILLOVER_DAYS=7

# --- Expense cadence detection (pipeline math; independent of Cadence UI tab) ---
# Spike when spend ≥ this multiple of typical. Default 2.0.
# CADENCE_SPIKE_RATIO=2.0
# Min distinct months of history before suggesting cadence. Default 3.
# CADENCE_MIN_HISTORY_MONTHS=3
# Month-gap range treated as “roughly yearly”. Defaults 10–14.
# CADENCE_YEARLY_GAP_MIN=10
# CADENCE_YEARLY_GAP_MAX=14

# --- LLM batch / timeout tuning (import pipeline) ---
# Rows per LLM request when a more specific size is unset.
LOCAL_BATCH_SIZE=50
# Rows per request for merchant/description enrichment.
DESCRIPTION_BATCH_SIZE=50
# Rows per request for classification.
CLASSIFICATION_BATCH_SIZE=25
# Heuristic seconds-per-row for import ETA in the UI. Default 1.2.
# PIPELINE_SECONDS_PER_ROW=1.2
# Temperature for pipeline LLM calls (0 = most deterministic). Default 0.
# PIPELINE_LLM_TEMPERATURE=0
# HTTP timeout (seconds) per LLM API call. Default 600.
REQUEST_TIMEOUT=600

# --- LLM call logging ---
# Log each LLM request/response summary to the console (and optionally a file).
LLM_LOG_CALLS=1
# LLM_LOG_FILE=data/llm.log
# Truncate logged bodies longer than this many characters. Default 8000.
# LLM_LOG_BODY_MAX_CHARS=8000

# --- Classification audit (optional stronger-model spot-check of labels) ---
# Re-check a sample of merchants after import / on a schedule.
CLASSIFICATION_AUDIT_ENABLED=0
# Model for audit only; if unset, falls back via role resolution.
# CLASSIFICATION_AUDIT_MODEL=gpt-4o
# Merchants to audit right after an import. Default 8.
CLASSIFICATION_AUDIT_POST_IMPORT_MERCHANTS=8
# Merchants to audit on a scheduled pass. Default 30.
CLASSIFICATION_AUDIT_SCHEDULED_MERCHANTS=30
# Min audit confidence (0–1) before treating disagreement as actionable. Default 0.85.
CLASSIFICATION_AUDIT_MIN_CONFIDENCE=0.85

# --- Classify vocabulary hint (steer LLM toward labels already in your DB) ---
# Include known categories/sub-categories from SQLite in classification prompts.
CLASSIFY_VOCABULARY_HINT=1
CLASSIFY_VOCABULARY_MAX_CATEGORIES=50
CLASSIFY_VOCABULARY_MAX_SUBS=120
# Fuzzy-match threshold (0–1) when normalizing LLM labels toward existing vocabulary.
CLASSIFY_VOCABULARY_SIMILARITY=0.75

# =============================================================================
# LLM — OpenAI cloud
# =============================================================================

# Backend for the OpenAI-compatible client: must be openai for this preset.
LLM_PROVIDER=openai
# Secret key from platform.openai.com (leave blank until you paste one; never commit a real key).
OPENAI_API_KEY=
# Default OpenAI model when role-specific models are unset.
OPENAI_MODEL=gpt-4o-mini

# Model for CSV import (descriptions + classification).
PIPELINE_MODEL=gpt-4o-mini
# Model for Ask chat, review suggest, edit insights.
CHAT_MODEL=gpt-4o-mini
