# LM Studio preset — copy to active config: cp config/.env.lmstudio config/.env

# =============================================================================
# Common — web app, pipeline, UI (same regardless of LLM backend)
# =============================================================================

# --- Web app paths ---
# FINANCE_DB_PATH=data/finance.db
# FINANCE_INBOX_DIR=input
# FINANCE_PROCESSED_DIR=processed
# FINANCE_MOVE_PROCESSED=true

# --- Web UI feature flags (1/true = show, 0/false = hide) ---
UI_SHOW_CADENCE=1
UI_SHOW_EXCEL_LOOKUP_IMPORT=1

# --- Pipeline lookups ---
LOOKUP_SOURCE=db
# LOOKUP_FILE=scripts/transaction-lookups.xlsx
# EXPORT_LOOKUPS=1

# --- Payroll spillover (salary in last N days of month → next budget month; see REQUIREMENTS.md §2.1) ---
# PAYROLL_SPILLOVER_DAYS=7

# --- Baseline buffers (Summary / Baseline tabs) ---
# BASELINE_VARIABLE_BUFFER_PCT=10
# BASELINE_FIXED_BUFFER_PCT=5
# BASELINE_RECOMMENDED_MONTHS=3

# --- Expense cadence detection (pipeline math; separate from Cadence UI tab) ---
# CADENCE_SPIKE_RATIO=2.0
# CADENCE_MIN_HISTORY_MONTHS=3
# CADENCE_YEARLY_GAP_MIN=10
# CADENCE_YEARLY_GAP_MAX=14

# --- LLM batch / timeout tuning (local backends) ---
LOCAL_BATCH_SIZE=50
DESCRIPTION_BATCH_SIZE=50
CLASSIFICATION_BATCH_SIZE=25
REQUEST_TIMEOUT=600

# =============================================================================
# LLM — LM Studio
# =============================================================================

LLM_PROVIDER=lmstudio
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen2.5-14b-instruct-mlx
# LM_STUDIO_MODEL=qwen2.5-coder-32b-instruct
# LM_STUDIO_MODEL=google/gemma-4-31b
# LM_STUDIO_API_KEY=lm-studio
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

PIPELINE_MODEL=qwen2.5-14b-instruct-mlx
CHAT_MODEL=qwen2.5-14b-instruct-mlx
# CHAT_MODEL=google/gemma-4-31b
