# Copy to .env and edit (web app + Run processing pipeline):
#   cp config/.env.example config/.env
# Or use a preset:
#   cp config/.env.ollama config/.env
#   cp config/.env.lmstudio config/.env
#
# Config model:
#   1. Set LLM_PROVIDER to the backend you are using.
#   2. Set that provider's *_BASE_URL and *_MODEL below (or use a preset file).
#   3. Optional split: PIPELINE_MODEL (Run processing) and CHAT_MODEL (web chat).
#   4. Optional generic overrides: LLM_BASE_URL / LLM_MODEL (any provider).
#
# Precedence: PIPELINE_MODEL/CHAT_MODEL > LLM_MODEL > provider-specific vars.

# --- Active provider (lmstudio | ollama | openai) ---
LLM_PROVIDER=lmstudio

# --- LM Studio (when LLM_PROVIDER=lmstudio) ---
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen2.5-14b-instruct-mlx
# LM_STUDIO_MODEL=qwen2.5-coder-32b-instruct
# LM_STUDIO_MODEL=google/gemma-4-31b
# LM_STUDIO_API_KEY=lm-studio
# LM_STUDIO_BASE_URL=http://192.168.0.7:1234/v1   # remote machine on LAN

# Split models — use same id for both, or point CHAT_MODEL at a second loaded model
PIPELINE_MODEL=qwen2.5-14b-instruct-mlx
CHAT_MODEL=qwen2.5-14b-instruct-mlx
# CHAT_MODEL=google/gemma-4-31b

# --- Ollama (when LLM_PROVIDER=ollama) ---
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:14b
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_API_KEY=ollama
# OLLAMA_BASE_URL=http://192.168.0.7:11434/v1   # remote machine on LAN
# PIPELINE_MODEL=qwen2.5:14b
# CHAT_MODEL=qwen2.5:14b

# --- OpenAI cloud (when LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# --- Optional generic overrides (any provider; advanced) ---
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_MODEL=google/gemma-4-31b

# Optional tuning (local LLM — Apple Silicon / M4 Max)
LOCAL_BATCH_SIZE=50
DESCRIPTION_BATCH_SIZE=50
CLASSIFICATION_BATCH_SIZE=25
# BATCH_SIZE=20                  # OpenAI cloud when --batch-size not set
REQUEST_TIMEOUT=600

# Payroll spillover: salary in last N days of prior month → next month's income (see REQUIREMENTS.md §2.1)
# PAYROLL_SPILLOVER_DAYS=7

# Pipeline lookups: db (default) or excel (legacy)
# LOOKUP_SOURCE=db
# LOOKUP_FILE=scripts/transaction-lookups.xlsx
# Set EXPORT_LOOKUPS=1 to also refresh transaction-lookups.xlsx on each run
# EXPORT_LOOKUPS=0

# Baseline buffers (Summary / Baseline tabs)
# BASELINE_VARIABLE_BUFFER_PCT=10
# BASELINE_FIXED_BUFFER_PCT=5
# BASELINE_RECOMMENDED_MONTHS=3

# Expense cadence detection (yearly / one-time spikes vs monthly run-rate)
# CADENCE_SPIKE_RATIO=2.0
# CADENCE_MIN_HISTORY_MONTHS=3
# CADENCE_YEARLY_GAP_MIN=10
# CADENCE_YEARLY_GAP_MAX=14

# --- Web app paths (same config/.env) ---
# FINANCE_DB_PATH=data/finance.db
# FINANCE_INBOX_DIR=input
# FINANCE_PROCESSED_DIR=processed
# FINANCE_MOVE_PROCESSED=true