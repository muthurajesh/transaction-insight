# Full reference — Ollama is the active default below; other providers are commented.
# Prefer copying a provider preset instead of editing this file by hand:
#   cp config/.env.ollama config/.env      # local (default qwen2.5:7b)
#   cp config/.env.lmstudio config/.env    # LM Studio
#   cp config/.env.openai config/.env      # OpenAI cloud (set OPENAI_API_KEY)
#
# Layout: common settings first, then LLM provider block at the bottom.
# Model precedence: PIPELINE_MODEL / CHAT_MODEL > LLM_MODEL > provider *_MODEL.
# Docs: docs/setup/LLM_SETUP.md
# Restart ./start.sh after changing this file (or the active config/.env).

# =============================================================================
# Common — web app, pipeline, UI (same regardless of LLM backend)
# =============================================================================

# --- Web app paths (optional; defaults match a normal checkout) ---
# SQLite database file for transactions, labels, rules, chat history, etc.
# FINANCE_DB_PATH=data/finance.db
# Folder where uploaded / dropped CSVs wait to be scanned.
# FINANCE_INBOX_DIR=input
# Folder where processed CSVs are moved after a successful import.
# FINANCE_PROCESSED_DIR=processed
# If true, move inbox CSVs into FINANCE_PROCESSED_DIR after import; if false, leave them in place.
# FINANCE_MOVE_PROCESSED=true

# --- Web UI feature flags (1/true/yes/on = on; 0/false/no/off = off) ---
# Show the Agent Workspace chrome (sidebar / Ask flow). Keep 1 for the normal product UI.
UI_AGENT_WORKSPACE=1
# Show the Cadence tab, pending-cadence UI, chat propose_cadence, and Learning Agent cadence analysis.
# Keep 0 until you intentionally use expense cadence features.
UI_SHOW_CADENCE=0
# simple = Import / Ask / Check labels / Settings only.
# expert = also Find & edit and Automate (Custom Rules). Users can override in Settings for this browser.
UI_MODE=simple
# After bulk Apply on Find & edit, show an AI “what changed / suggested rule” insight modal.
# When 0, Apply still works but shows a short “insight turned off” message instead of calling the LLM.
EDIT_INSIGHT_ENABLED=1

# --- Chat (Ask / Workspace) ---
# How many prior user+assistant turns to send with each chat request (0 = no history). Max 100. Default 20.
# CHAT_HISTORY_MESSAGES=20
# Assumed context window size (tokens) for the toolbar “context used” meter only — does not change the model.
# CHAT_CONTEXT_TOKEN_LIMIT=32768

# --- Learning Agent (scheduled Decision Analyst → Workspace inbox) ---
# Master switch for the background job that mines decision_events and proposes inbox insights.
LEARNING_AGENT_ENABLED=0
# Hours between automatic Learning Agent runs (minimum 1). Default 3.
# LEARNING_AGENT_INTERVAL_HOURS=3
# Only consider decision events from the last N days. Default 30.
# LEARNING_AGENT_LOOKBACK_DAYS=30
# Cap how many new insights one run may insert. Default 10.
# LEARNING_AGENT_MAX_INSIGHTS=10
# Max tool-calling rounds (e.g. query_sql) per Learning Agent LLM session. Default 8.
# LEARNING_AGENT_MAX_TOOL_ROUNDS=8
# If 0, run analysis without calling the LLM (heuristic-only path when supported). Default 1.
# LEARNING_AGENT_USE_LLM=1
# Optional larger model for Learning Agent only; if unset, uses CHAT_MODEL.
# LEARNING_AGENT_MODEL=qwen2.5-coder:32b

# --- Payroll spillover ---
# Salary / paycheck dated in the last N days of a month is attributed to the *next* budget month.
# PAYROLL_SPILLOVER_DAYS=7

# --- Expense cadence detection (pipeline math; independent of Cadence UI tab) ---
# Flag a month as a spike when spend is this multiple of the typical amount. Default 2.0.
# CADENCE_SPIKE_RATIO=2.0
# Need at least this many distinct months of history before suggesting a cadence. Default 3.
# CADENCE_MIN_HISTORY_MONTHS=3
# Gap (in months) treated as “roughly yearly” for yearly cadence detection. Defaults 10–14.
# CADENCE_YEARLY_GAP_MIN=10
# CADENCE_YEARLY_GAP_MAX=14

# --- LLM batch / timeout tuning (import pipeline) ---
# Rows per LLM request for local providers when a more specific batch size is unset. Default 40 in code; 50 here.
LOCAL_BATCH_SIZE=50
# Rows per request for merchant/description enrichment. 0 in code = fall back to LOCAL_BATCH_SIZE / BATCH_SIZE.
DESCRIPTION_BATCH_SIZE=50
# Rows per request for classification (category / Fixed-Variable / etc.). Smaller = safer for weaker GPUs.
CLASSIFICATION_BATCH_SIZE=25
# Heuristic seconds-per-row used only to estimate import ETA in the UI. Default 1.2.
# PIPELINE_SECONDS_PER_ROW=1.2
# Temperature for pipeline LLM calls (0 = most deterministic labels). Default 0.
# PIPELINE_LLM_TEMPERATURE=0
# Legacy generic batch size fallback (used when LOCAL / DESCRIPTION / CLASSIFICATION sizes are 0). Default 20.
# BATCH_SIZE=20
# HTTP timeout (seconds) for each LLM API call. Local models often need several minutes. Default 600.
REQUEST_TIMEOUT=600

# --- LLM call logging ---
# Log each LLM request/response summary to the console (and optionally a file). 1 = on.
LLM_LOG_CALLS=1
# Relative path for the LLM log file when logging is on. Default data/llm.log.
# LLM_LOG_FILE=data/llm.log
# Truncate logged request/response bodies longer than this many characters. Default 8000.
# LLM_LOG_BODY_MAX_CHARS=8000

# --- Classification audit (optional stronger-model spot-check of labels) ---
# After import / on a schedule, re-check a sample of merchants with CLASSIFICATION_AUDIT_MODEL.
CLASSIFICATION_AUDIT_ENABLED=0
# Model used only for audit spot-checks; if unset, falls back via role resolution (often CHAT / provider model).
# CLASSIFICATION_AUDIT_MODEL=qwen2.5-coder:32b
# How many merchants to audit right after an import. Default 8.
CLASSIFICATION_AUDIT_POST_IMPORT_MERCHANTS=8
# How many merchants to audit on a scheduled pass. Default 30.
CLASSIFICATION_AUDIT_SCHEDULED_MERCHANTS=30
# Minimum confidence (0–1) from the audit model before treating a disagreement as actionable. Default 0.85.
CLASSIFICATION_AUDIT_MIN_CONFIDENCE=0.85

# --- Classify vocabulary hint (steer LLM toward labels already in your DB) ---
# When 1, include a short list of known categories/sub-categories from SQLite in classification prompts.
CLASSIFY_VOCABULARY_HINT=1
# Max distinct AI categories to include in that hint. Default 50.
CLASSIFY_VOCABULARY_MAX_CATEGORIES=50
# Max distinct sub-categories to include. Default 120.
CLASSIFY_VOCABULARY_MAX_SUBS=120
# Fuzzy-match threshold (0–1) when normalizing LLM labels toward existing vocabulary. Default 0.75.
CLASSIFY_VOCABULARY_SIMILARITY=0.75

# =============================================================================
# LLM — pick one provider (ollama | lmstudio | openai)
# Active default: Ollama (matches config/.env.ollama). To switch in this file:
# comment the active block and uncomment LM Studio or OpenAI below.
# Or: cp config/.env.lmstudio|openai config/.env
# =============================================================================

# Which backend the OpenAI-compatible client talks to: ollama | lmstudio | openai
LLM_PROVIDER=ollama

# --- Ollama (active when LLM_PROVIDER=ollama) ---
# OpenAI-compatible base URL for the local Ollama server (must include /v1).
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Default Ollama model name (ollama pull <name>). Used when role-specific models are unset.
OLLAMA_MODEL=qwen2.5:7b
# Optional upgrade on machines with more RAM:
# OLLAMA_MODEL=qwen2.5:14b
# Placeholder API key some OpenAI clients require; Ollama ignores the value.
# OLLAMA_API_KEY=ollama

# Model for CSV import (descriptions + classification). Overrides OLLAMA_MODEL when set.
PIPELINE_MODEL=qwen2.5:7b
# Model for Ask chat, review suggest, edit insights. Overrides OLLAMA_MODEL when set.
CHAT_MODEL=qwen2.5:7b

# --- LM Studio (when LLM_PROVIDER=lmstudio) — uncomment; comment Ollama block above ---
# LLM_PROVIDER=lmstudio
# OpenAI-compatible URL from LM Studio “Serve on Local Network” (include /v1).
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Model id as shown in LM Studio (must be loaded).
# LM_STUDIO_MODEL=qwen2.5-14b-instruct-mlx
# LM_STUDIO_MODEL=qwen2.5-coder-32b-instruct
# Placeholder key LM Studio often accepts.
# LM_STUDIO_API_KEY=lm-studio
# PIPELINE_MODEL=qwen2.5-14b-instruct-mlx
# CHAT_MODEL=qwen2.5-14b-instruct-mlx

# --- OpenAI cloud (when LLM_PROVIDER=openai) — uncomment; comment Ollama block above ---
# LLM_PROVIDER=openai
# Secret key from platform.openai.com (never commit a real key).
# OPENAI_API_KEY=sk-your-key-here
# Default OpenAI model when role-specific models are unset.
# OPENAI_MODEL=gpt-4o-mini
# PIPELINE_MODEL=gpt-4o-mini
# CHAT_MODEL=gpt-4o-mini

# --- Optional generic overrides (any provider; advanced) ---
# Force base URL regardless of provider defaults (rare; prefer provider-specific *_BASE_URL).
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# Force a single model name for roles that do not set PIPELINE_MODEL / CHAT_MODEL.
# LLM_MODEL=qwen2.5:7b
