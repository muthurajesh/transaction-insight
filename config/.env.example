# Copy to active config (web app + Run processing pipeline):
#   cp config/.env.example config/.env
# Or use a preset:
#   cp config/.env.lmstudio config/.env
#   cp config/.env.ollama config/.env
#
# Layout: common settings first, then LLM provider block at the bottom.
# Precedence: PIPELINE_MODEL/CHAT_MODEL > LLM_MODEL > provider-specific *_MODEL vars.

# =============================================================================
# Common — web app, pipeline, UI (same regardless of LLM backend)
# =============================================================================

# --- Web app paths ---
# FINANCE_DB_PATH=data/finance.db
# FINANCE_INBOX_DIR=input
# FINANCE_PROCESSED_DIR=processed
# FINANCE_MOVE_PROCESSED=true

# --- Web UI feature flags (1/true = show, 0/false = hide) ---
UI_AGENT_WORKSPACE=1
UI_SHOW_CADENCE=0
# When 0: hides Cadence tab, Pending cadence group, chat propose_cadence, and Learning Agent cadence analysis.

# --- Chat ---
# Prior user/assistant turns sent to the LLM (0 = disabled). Default 20.
# CHAT_HISTORY_MESSAGES=20

# Approximate model context window for the chat meter (tokens). Default 32768.
# CHAT_CONTEXT_TOKEN_LIMIT=32768

# --- Learning Agent (decision pattern analysis → Workspace inbox) ---
LEARNING_AGENT_ENABLED=0
# LEARNING_AGENT_INTERVAL_HOURS=3
# LEARNING_AGENT_LOOKBACK_DAYS=30
# LEARNING_AGENT_MAX_INSIGHTS=10
# LEARNING_AGENT_MAX_TOOL_ROUNDS=8
# LEARNING_AGENT_USE_LLM=1

# --- Learning Agent model (optional; defaults to CHAT_MODEL) ---
# Use a larger model for decision-memory analysis (query_sql tool loop).
# LEARNING_AGENT_MODEL=qwen2.5-coder:32b
# LEARNING_AGENT_MODEL=qwen2.5-coder-32b-instruct

# --- Payroll spillover (salary in last N days of month → next budget month; see docs/product/PRODUCT_CHARTER.md §2.1) ---
# PAYROLL_SPILLOVER_DAYS=7

# --- Expense cadence detection (pipeline math; separate from Cadence UI tab) ---
# CADENCE_SPIKE_RATIO=2.0
# CADENCE_MIN_HISTORY_MONTHS=3
# CADENCE_YEARLY_GAP_MIN=10
# CADENCE_YEARLY_GAP_MAX=14

# --- LLM batch / timeout tuning ---
LOCAL_BATCH_SIZE=50
DESCRIPTION_BATCH_SIZE=50
CLASSIFICATION_BATCH_SIZE=25
# PIPELINE_SECONDS_PER_ROW=1.2
# PIPELINE_LLM_TEMPERATURE=0
# BATCH_SIZE=20
REQUEST_TIMEOUT=600

# --- LLM call logging (console + file) ---
LLM_LOG_CALLS=1
# LLM_LOG_FILE=data/llm.log
# LLM_LOG_BODY_MAX_CHARS=8000
# LLM_LOG_CALLS=0

# --- Classification audit (14b pipeline + stronger model spot-check) ---
CLASSIFICATION_AUDIT_ENABLED=1
# CLASSIFICATION_AUDIT_MODEL=qwen2.5-coder:32b
CLASSIFICATION_AUDIT_POST_IMPORT_MERCHANTS=8
CLASSIFICATION_AUDIT_SCHEDULED_MERCHANTS=30
CLASSIFICATION_AUDIT_MIN_CONFIDENCE=0.85

# --- Classify vocabulary hint (pipeline + audit; prefer known labels from DB) ---
CLASSIFY_VOCABULARY_HINT=1
CLASSIFY_VOCABULARY_MAX_CATEGORIES=50
CLASSIFY_VOCABULARY_MAX_SUBS=120
CLASSIFY_VOCABULARY_SIMILARITY=0.75

# =============================================================================
# LLM — pick one provider (lmstudio | ollama | openai)
# =============================================================================

LLM_PROVIDER=lmstudio

# --- LM Studio (when LLM_PROVIDER=lmstudio) ---
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen2.5-14b-instruct-mlx
# LM_STUDIO_MODEL=qwen2.5-coder-32b-instruct
# LM_STUDIO_MODEL=google/gemma-4-31b
# LM_STUDIO_API_KEY=lm-studio
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

PIPELINE_MODEL=qwen2.5-14b-instruct-mlx
CHAT_MODEL=qwen2.5-14b-instruct-mlx
# CHAT_MODEL=google/gemma-4-31b

# --- Ollama (when LLM_PROVIDER=ollama) — uncomment and comment LM Studio block above ---
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:14b
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_API_KEY=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# PIPELINE_MODEL=qwen2.5:14b
# CHAT_MODEL=qwen2.5:14b

# --- OpenAI cloud (when LLM_PROVIDER=openai) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini
# PIPELINE_MODEL=gpt-4o-mini
# CHAT_MODEL=gpt-4o-mini

# --- Optional generic overrides (any provider; advanced) ---
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_MODEL=google/gemma-4-31b
