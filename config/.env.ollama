# Ollama preset — copy to active config: cp config/.env.ollama config/.env
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:14b
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_API_KEY=ollama

# Optional split (Ollama usually runs one model at a time — use same id for both, or swap CHAT_MODEL after ollama pull)
# PIPELINE_MODEL=qwen2.5:14b
# CHAT_MODEL=qwen2.5:14b

# M4 Max / local tuning
LOCAL_BATCH_SIZE=50
DESCRIPTION_BATCH_SIZE=50
CLASSIFICATION_BATCH_SIZE=25
REQUEST_TIMEOUT=600

# Ollama on another machine on your LAN:
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
